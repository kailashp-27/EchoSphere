        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/prompts",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Assignment Review\",\"prompt\":\"Explain software testing\",\"category\":\"Testing\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
