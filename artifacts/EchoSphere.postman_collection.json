          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Graph has nodes and links',()=>{const g=pm.response.json();pm.expect(g.nodes.length).to.be.above(0);pm.expect(g.links).to.be.an('array');});",
              "pm.collectionVariables.set('graph',JSON.stringify(pm.response.json()));"
            ]
          }
        }
      ]
    },
