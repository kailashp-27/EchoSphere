        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Summary contains text',()=>pm.expect(pm.response.json().result.length).to.be.above(20));"
            ]
          }
        }
      ]
    },
