              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Valid flashcards',()=>{const f=pm.response.json().flashcards;pm.expect(f.length).to.be.above(0);f.forEach(c=>{pm.expect(c.front).to.be.a('string');pm.expect(c.back).to.be.a('string');});});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Live exam questions",
      "request": {
        "method": "POST",
        "header": [
