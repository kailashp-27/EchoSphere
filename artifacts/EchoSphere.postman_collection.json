{
  "info": {
    "name": "EchoSphere Assignment 3 Integration and Regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Real local MongoDB and Ollama tests. Run only against the isolated assignment database. Tests create their own data."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "01 Health and MongoDB",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Database connected',()=>pm.expect(pm.response.json().database).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create folder",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/folders",
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Assignment 3 Tests\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('folderId',pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Browse folders",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/folders"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Created folder is listed',()=>pm.expect(pm.response.json().folders.some(f=>f._id===pm.collectionVariables.get('folderId'))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Create study note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/knowledge/note",
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Software Engineering Testing\",\"content\":\"Integration testing verifies that different software modules work together. Regression testing ensures that existing features still work after changes. Mutation testing deliberately changes source code and checks whether tests detect the changes. Version control tracks changes through commits and branches. EchoSphere stores notes in MongoDB and uses Ollama for local AI generation.\",\"folderId\":\"{{folderId}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('noteId',pm.response.json()._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 List knowledge files",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/knowledge/all-files"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Note available to AI tools',()=>pm.expect(pm.response.json().files.some(f=>f._id===pm.collectionVariables.get('noteId'))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
