      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/prompts"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Prompt saved',()=>pm.expect(pm.response.json().some(p=>p._id===pm.collectionVariables.get('promptId'))).to.be.true);"
            ]
          }
        }
      ]
    },
    {
